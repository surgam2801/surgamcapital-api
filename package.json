{
  "name": "surgamcapital-api",
  "version": "1.0.0",
  "description": "Backend API service for Surgam Capital built with Express and tRPC",
  "type": "module",
  "main": "server/_core/index.ts",
  "scripts": {
    "dev": "cross-env PORT=3000 NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@trpc/server": "11.7.2",
    "axios": "^1.13.2",
    "cookie": "^1.1.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.7",
    "express": "^4.22.1",
    "jose": "6.1.0",
    "mysql2": "^3.16.0",
    "superjson": "^1.13.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.3",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.12",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  }
}
